{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lumei:gws:editorial:1.0.0",
  "title": "Lumei editorial release-candidate card",
  "description": "Locators and claim support require semantic review; no individual assessment.",
  "$defs": {
    "SourceRef": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "minProperties": 2
        },
        "review_decision": {
          "enum": [
            "include",
            "adapt"
          ]
        },
        "support_role": {
          "enum": [
            "behavior_support",
            "contextual_behavior_lens",
            "related_concept_only",
            "role_conditional_only",
            "coaching_design_only",
            "foresight_only"
          ]
        },
        "supported_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_claim": {
          "type": "string",
          "minLength": 1
        },
        "adaptation_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "candidate_id",
        "source_id",
        "version",
        "locator",
        "review_decision",
        "support_role",
        "supported_fields",
        "supported_claim",
        "adaptation_limits"
      ],
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "authorship": {
          "const": "lumei-original-adaptation"
        },
        "supporting_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "action_id",
        "action",
        "authorship",
        "supporting_candidate_ids"
      ],
      "additionalProperties": false
    },
    "Practice": {
      "type": "object",
      "properties": {
        "authorship": {
          "const": "lumei-original-design"
        },
        "optional": {
          "const": true
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "user_attempt": {
          "type": "string",
          "minLength": 1
        },
        "feedback_basis": {
          "type": "string",
          "minLength": 1
        },
        "assistance_boundary": {
          "type": "string",
          "minLength": 1
        },
        "transfer_to_another_context": {
          "type": "string",
          "minLength": 1
        },
        "evidence_to_collect_next": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "authorship",
        "optional",
        "target",
        "user_attempt",
        "feedback_basis",
        "assistance_boundary",
        "transfer_to_another_context",
        "evidence_to_collect_next",
        "stop_conditions"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "applicable_roles": {
          "const": [
            "contributor",
            "manager"
          ]
        },
        "required_managerial_authority": {
          "const": false
        },
        "work_contexts": {
          "const": [
            "desk",
            "frontline"
          ]
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "applicable_roles",
        "required_managerial_authority",
        "work_contexts",
        "boundary_conditions"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^GWS-[a-z0-9-]+$"
        },
        "editorial_version": {
          "const": "0.2.0"
        },
        "status": {
          "const": "release-candidate"
        },
        "runtime_authority": {
          "const": false
        },
        "contract_status": {
          "const": "editorial-schema-1.0.0-and-shared-contract-1.0.0-validated"
        },
        "title_th": {
          "type": "string",
          "minLength": 1
        },
        "title_en": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "workplace_situation": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "observable_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_to_look_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "interpretation_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "practice": {
          "$ref": "#/$defs/Practice"
        },
        "human_ai_judgment": {
          "type": "string",
          "minLength": 1
        },
        "coaching_overlay_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "adaptation_note": {
          "type": "string",
          "minLength": 1
        },
        "design_notes": {
          "type": "string",
          "minLength": 1
        },
        "distinction": {
          "type": "object",
          "properties": {
            "compared_with": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "separation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "compared_with",
            "separation"
          ],
          "additionalProperties": false
        },
        "manager_branch": {
          "type": "object",
          "properties": {
            "requires_actual_authority": {
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "source_ref": {
              "$ref": "#/$defs/SourceRef"
            }
          },
          "required": [
            "requires_actual_authority",
            "note",
            "source_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "skill_id",
        "editorial_version",
        "status",
        "runtime_authority",
        "contract_status",
        "title_th",
        "title_en",
        "family_id",
        "workplace_situation",
        "purpose",
        "scope",
        "observable_actions",
        "evidence_to_look_for",
        "interpretation_limits",
        "practice",
        "human_ai_judgment",
        "coaching_overlay_ids",
        "source_refs",
        "adaptation_note",
        "design_notes",
        "distinction"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Card"
}
